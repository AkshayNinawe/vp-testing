# Copy to .env for local API, and to .env.production for frontend builds.

# --- Frontend (Vite) ---
# Local/dev: point at the live VoltTrack API (recommended when local Express is not running)
VITE_API_URL=https://vishwaspower.in/volttrack

# Or leave empty and run `npm run dev:server` so Vite proxies /api → http://localhost:4000
# VITE_API_URL=

# Optional Vite proxy target when VITE_API_URL is empty:
# VITE_DEV_PROXY_TARGET=http://localhost:4000

# --- Backend (server/.env or process env) ---
# PORT=4000
# APP_URL=https://test.apivishvaspower.online
# CORS_ORIGINS=https://test.apivishvaspower.online,https://test.apivishvaspower.com,http://localhost:3000,http://localhost:3002
# API_BASE_PATH=/volttrack
# MONGODB_URI=mongodb://127.0.0.1:27017/volttrack
# MONGODB_DB=volttrack
# JWT_SECRET=change-me
