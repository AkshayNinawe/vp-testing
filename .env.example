# Copy to .env for local API, and to .env.production for frontend builds.

# --- Frontend (Vite) ---
# Local: leave empty (Vite proxies /api → http://localhost:4000)
# Production frontend at https://test.apivishvaspower.com/ — same-origin /api:
VITE_API_URL=

# Or point at an absolute API base (no trailing slash):
# VITE_API_URL=https://test.apivishvaspower.com
# VITE_API_URL=http://localhost:4000

# --- Backend (server/.env or process env) ---
# PORT=4000
# APP_URL=https://test.apivishvaspower.com
# CORS_ORIGINS=https://test.apivishvaspower.com,http://localhost:3000
# API_BASE_PATH=
# MONGODB_URI=mongodb://127.0.0.1:27017/volttrack
# MONGODB_DB=volttrack
# JWT_SECRET=change-me
