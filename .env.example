# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Frontend URL
APP_URL=http://test.apivishvaspower.com
CORS_ORIGINS=http://test.apivishvaspower.com,https://test.apivishvaspower.com,http://localhost:3000,https://vishwaspower.in

# Backend API
PORT=4000
JWT_SECRET=volttrack-dev-secret-change-me

# MongoDB (supports MONGO_URL or MONGODB_URI)
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.mgceyfi.mongodb.net/VishwasPower
MONGODB_DB=VishwasPower

# Production frontend API base (no trailing slash)
# Requests go to: https://vishwaspower.in/testing/api/...
VITE_API_URL=https://vishwaspower.in/testing

# Express mount path for reverse-proxy deployments
API_BASE_PATH=/testing
